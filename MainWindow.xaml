<Window x:Class="MediaController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MediaController"
        Width="640" Height="48"
        MinWidth="260" MinHeight="32" MaxHeight="120"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#FF1E1E1E"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="FgDim" Color="#FFB4B4B4" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Background="Transparent"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <Border.ContextMenu>
            <ContextMenu Opened="Menu_Opened">
                <MenuItem Header="Colocar junto al reloj" Click="ResetPosition_Click" />
                <MenuItem Header="Restablecer separador" Click="ResetSplitter_Click" />
                <MenuItem x:Name="StartupItem" Header="Iniciar con Windows" IsCheckable="True" Click="Startup_Click" />
                <Separator />
                <MenuItem Header="Salir" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="6,3,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />                         <!-- 0 portada -->
                <ColumnDefinition x:Name="InfoCol" Width="170" />         <!-- 1 título / artista -->
                <ColumnDefinition Width="Auto" />                         <!-- 2 separador -->
                <ColumnDefinition Width="*" />                            <!-- 3 espacio libre -->
                <ColumnDefinition Width="Auto" />                         <!-- 4 aleatorio -->
                <ColumnDefinition Width="Auto" />                         <!-- 5 anterior / play / siguiente -->
                <ColumnDefinition Width="Auto" />                         <!-- 6 progreso -->
                <ColumnDefinition Width="Auto" />                         <!-- 7 volumen -->
                <ColumnDefinition Width="Auto" />                         <!-- 8 historial -->
            </Grid.ColumnDefinitions>

            <!-- Portada -->
            <Border x:Name="CoverBox" Grid.Column="0"
                    Width="38" Height="38"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Background="#FF2C2C2C">
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FF8A8A8A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <!-- Título y artista -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="TitleText"
                           Text="Nada reproduciéndose"
                           Foreground="#FFFFFFFF"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           Text="Abre Spotify, YouTube Music, VLC…"
                           Foreground="{StaticResource FgDim}"
                           FontFamily="Segoe UI" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Separador arrastrable: define cuánto espacio tiene la info de la canción -->
            <Border x:Name="Splitter" Grid.Column="2" Width="9" Background="Transparent"
                    Cursor="SizeWE" ToolTip="Arrastra para ajustar el espacio"
                    MouseLeftButtonDown="Splitter_MouseLeftButtonDown"
                    MouseMove="Splitter_MouseMove"
                    MouseLeftButtonUp="Splitter_MouseLeftButtonUp"
                    MouseEnter="Splitter_MouseEnter"
                    MouseLeave="Splitter_MouseLeave">
                <Rectangle x:Name="SplitterLine" Width="1" Margin="0,6,0,6"
                           HorizontalAlignment="Center" Fill="#44FFFFFF" />
            </Border>

            <!-- Aleatorio -->
            <Button x:Name="ShuffleBtn" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                    Foreground="#FFA8A8A8" ToolTip="Aleatorio" Click="Shuffle_Click">
                <Grid Width="20" Height="30">
                    <TextBlock x:Name="ShuffleIcon" Text="&#xE8B1;" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="ShuffleDot" Width="4" Height="4" Fill="#FFFFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="0,0,0,3"
                             Visibility="Collapsed" />
                </Grid>
            </Button>
            <!-- Anterior / Play-Pausa / Siguiente (siempre visibles) -->
            <StackPanel x:Name="ControlsPanel" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;"
                        ToolTip="Anterior" Click="Prev_Click" />
                <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}" Content="&#xE768;"
                        ToolTip="Reproducir / pausar" Click="Play_Click" />
                <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;"
                        ToolTip="Siguiente" Click="Next_Click" />
            </StackPanel>

            <!-- Progreso -->
            <Grid x:Name="ProgressPanel" Grid.Column="6" Width="150" VerticalAlignment="Center" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="TimesRow" Grid.Row="0">
                    <TextBlock x:Name="PosText" Text="0:00" FontFamily="Segoe UI" FontSize="10"
                               Foreground="{StaticResource FgDim}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DurText" Text="0:00" FontFamily="Segoe UI" FontSize="10"
                               Foreground="{StaticResource FgDim}" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="ProgressHost" Grid.Row="1" Height="12"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                      SizeChanged="Progress_SizeChanged">
                    <Border Height="4" CornerRadius="2" Background="#38FFFFFF" />
                    <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                            Background="#FFFFFFFF" HorizontalAlignment="Left" Width="0" />
                </Grid>
            </Grid>

            <!-- Volumen (con el número) -->
            <StackPanel x:Name="VolumePanel" Grid.Column="7" Orientation="Horizontal"
                        VerticalAlignment="Center" Background="Transparent"
                        MouseWheel="Volume_MouseWheel">
                <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;"
                        Width="28" Height="28" ToolTip="Silenciar" Click="Mute_Click" />
                <StackPanel x:Name="VolumeBar" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid x:Name="VolumeHost" Width="72" Height="16"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Volume_MouseLeftButtonDown"
                      MouseMove="Volume_MouseMove"
                      MouseLeftButtonUp="Volume_MouseLeftButtonUp"
                      SizeChanged="Volume_SizeChanged">
                    <Border Height="4" CornerRadius="2" Background="#38FFFFFF" />
                    <Border x:Name="VolumeFill" Height="4" CornerRadius="2"
                            Background="#FFFFFFFF" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <TextBlock x:Name="VolText" Text="0" Width="26" Margin="6,0,0,0"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#FFE0E0E0"
                           TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Historial -->
            <Button x:Name="HistBtn" Grid.Column="8" Style="{StaticResource IconButton}" Content="&#xE81C;"
                    Margin="4,0,0,0" ToolTip="Historial" Click="History_Click" />

            <Popup x:Name="HistPopup"
                   PlacementTarget="{Binding ElementName=Root}"
                   Placement="Top"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None">
                <Border x:Name="HistPanel" Width="640"
                        Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1"
                        CornerRadius="8" Padding="12,8,12,8">
                    <StackPanel>
                        <TextBlock Text="Reproducido recientemente" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#FFA8A8A8" Margin="0,0,0,4" />
                        <StackPanel x:Name="HistList" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
